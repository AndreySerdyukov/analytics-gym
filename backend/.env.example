# Шаблон окружения backend. Скопировать в backend/.env и поправить под себя.
# Реальный .env в .gitignore — секреты никогда не коммитим.

# Подключение к PostgreSQL (SQLAlchemy + psycopg 3).
# Вариант Docker (docker-compose.yml): пользователь/пароль/БД = analytics_gym, порт 5433.
DATABASE_URL=postgresql+psycopg://analytics_gym:analytics_gym@localhost:5433/analytics_gym

# Окружение приложения: development | production
APP_ENV=development

# Каталог с контентом (задачи, теория, датасеты).
# По умолчанию — content/ рядом с backend/, переопределять обычно не нужно.
# CONTENT_DIR=../content
